extends default

block content
  header
    a.logo(href='/') Book Share
    form(action='/search' method='GET')
      input.search-input(autofocus='' value=`${searchQuery || ''}` placeholder='Search a book...' type='search' name='q')

  .container
    if !books
      .result-count
        p No results found for your query:
        |
        strong #{searchQuery}
    else
      ul.search-results
        include mixins/results
        +results(books)