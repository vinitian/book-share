
mixin results(books)
  script(src='/js/borrowBook.js')
  each book in books
    li.news-article
      a.title-link(target='_blank' rel='noreferrer noopener')
        h3.title #{book.title}
      .metadata by
        |
        |
        span.author #{book.author}
        |
        | | Posted on
        |
        time.created-date #{dateFns.format(new Date(`${book.datePosted}`), 'LLL dd, yyyy')}
        
      if book.isBorrowed
        p "borrowed!"
      else
        button.btn.btn-default(type="button", data-dismiss="modal", onclick=`borrowBook('${book._id}')`) Borrow