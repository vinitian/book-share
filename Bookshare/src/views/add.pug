extends default 

block content
  body
    p test
    .modal-dialog
        .modal-content

          .modal-header
            button.close(type="button", data-dismiss="modal")
              span(aria-hidden="true") ×
              span.sr-only Close
            h4#myModalLabel.modal-title
              | Post a Book

          .modal-body
            form(role='form' method='POST' action="/add")
              div.form-group
                label(for='title') Title:
                input#title.form-control(type='text', placeholder='Metamorphosis' name='title')
              div.form-group
                label(for='author') Author:
                input#author.form-control(type='text', placeholder='Franz Kafka' name='author')
              button.btn.btn-primary(type="submit") Submit
              button.btn.btn-default(type="button", data-dismiss="modal")
                | Close
          if bookAdded
            p Book added!